{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "100X Investment Universe",
  "type": "object",
  "required": [
    "schema_version",
    "countries",
    "companies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ticker",
          "country",
          "currency",
          "sector",
          "industry",
          "themes",
          "status",
          "beyond_100x",
          "thesis_health",
          "position_action",
          "fresh_capital_action",
          "research_path",
          "last_reviewed",
          "scores"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{10}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "sector": {
            "type": "string",
            "enum": [
              "COMMUNICATION_SERVICES",
              "CONSUMER_DISCRETIONARY",
              "CONSUMER_STAPLES",
              "ENERGY",
              "FINANCIALS",
              "HEALTH_CARE",
              "INDUSTRIALS",
              "INFORMATION_TECHNOLOGY",
              "MATERIALS",
              "REAL_ESTATE",
              "UTILITIES"
            ]
          },
          "status": {
            "enum": [
              "CORE",
              "WATCH",
              "FRONTIER",
              "REJECTED"
            ]
          },
          "thesis_health": {
            "enum": [
              "STRENGTHENING",
              "INTACT",
              "UNDER_REVIEW",
              "WEAKENING",
              "BROKEN"
            ]
          },
          "position_action": {
            "enum": [
              "HOLD",
              "REDUCE",
              "EXIT"
            ]
          },
          "fresh_capital_action": {
            "enum": [
              "DEPLOY",
              "WAIT"
            ]
          },
          "research_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_reviewed": {
            "type": "string",
            "format": "date"
          },
          "scores": {
            "type": "object",
            "required": [
              "business_potential",
              "probability_of_success",
              "investment_attractiveness",
              "overall_100x"
            ],
            "additionalProperties": false,
            "properties": {
              "business_potential": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10
              },
              "probability_of_success": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10
              },
              "investment_attractiveness": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10
              },
              "overall_100x": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "industry": {
            "type": "string",
            "enum": [
              "SOFTWARE",
              "IT_SERVICES",
              "SEMICONDUCTORS",
              "TECHNOLOGY_HARDWARE",
              "ELECTRONIC_EQUIPMENT",
              "ELECTRONIC_MANUFACTURING_SERVICES",
              "COMMUNICATIONS_EQUIPMENT",
              "BANKS",
              "DIVERSIFIED_FINANCIALS",
              "CAPITAL_MARKETS",
              "INSURANCE",
              "AEROSPACE_DEFENSE",
              "MACHINERY",
              "ELECTRICAL_EQUIPMENT",
              "INDUSTRIAL_COMPONENTS",
              "ENGINEERING_SERVICES",
              "CONSTRUCTION_ENGINEERING",
              "TRANSPORTATION_LOGISTICS",
              "PHARMACEUTICALS",
              "BIOTECHNOLOGY",
              "LIFE_SCIENCES_TOOLS_SERVICES",
              "HEALTH_CARE_SERVICES",
              "MEDICAL_DEVICES",
              "AUTOMOBILES",
              "AUTOMOBILE_COMPONENTS",
              "HOUSEHOLD_DURABLES",
              "CONSUMER_PRODUCTS",
              "RETAIL",
              "TRAVEL_SERVICES",
              "FOOD_BEVERAGES",
              "HOUSEHOLD_PERSONAL_PRODUCTS",
              "AGRICULTURE",
              "CHEMICALS",
              "METALS_MINING",
              "CONSTRUCTION_MATERIALS",
              "ADVANCED_MATERIALS",
              "OIL_GAS",
              "ENERGY_EQUIPMENT",
              "POWER_GENERATION",
              "RENEWABLE_POWER",
              "POWER_TRANSMISSION",
              "TELECOM_SERVICES",
              "DIGITAL_PLATFORMS",
              "INTERACTIVE_MEDIA",
              "ENTERTAINMENT",
              "REAL_ESTATE",
              "REAL_ESTATE_SERVICES"
            ]
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AI",
                "CLOUD",
                "CYBERSECURITY",
                "ADVANCED_COMPUTING",
                "DATA_INFRASTRUCTURE",
                "DIGITAL_TRANSFORMATION",
                "ROBOTICS_AUTOMATION",
                "QUANTUM_COMPUTING",
                "SEMICONDUCTOR_ECOSYSTEM",
                "CHIP_DESIGN",
                "CHIP_MANUFACTURING",
                "OSAT",
                "DEFENCE",
                "AEROSPACE",
                "SPACE",
                "DRONES",
                "ENERGY_TRANSITION",
                "ENERGY_STORAGE",
                "BATTERIES",
                "NUCLEAR",
                "ELECTRIFICATION",
                "GRID_MODERNIZATION",
                "CLIMATE_TECH",
                "BIOTECH_INNOVATION",
                "CDMO",
                "GENOMICS",
                "PRECISION_MEDICINE",
                "HEALTH_TECH",
                "FINTECH",
                "DIGITAL_PAYMENTS",
                "SAAS",
                "E_COMMERCE",
                "ADVANCED_MANUFACTURING",
                "PRECISION_MANUFACTURING",
                "WATER_INFRASTRUCTURE",
                "TELECOM_INFRASTRUCTURE"
              ]
            },
            "uniqueItems": true,
            "minItems": 0,
            "maxItems": 5
          },
          "beyond_100x": {
            "type": "boolean",
            "description": "Discovery flag for companies with a compelling investment case worth surfacing outside the strict 100X framework. CORE companies must always be false."
          }
        }
      }
    }
  }
}
